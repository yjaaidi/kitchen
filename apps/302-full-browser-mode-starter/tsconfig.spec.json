{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "lib": ["DOM", "DOM.Iterable", "ES2019"],
    "types": [
      "node",
      "vite/client",
      "vitest",
      "vitest/importMeta",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "@react-router/node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "test-setup-*.ts",
    "vite.config.mts",
    "vitest.config.mts",
    "app/**/*.spec.ts",
    "app/**/*.spec.tsx",
    "app/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
